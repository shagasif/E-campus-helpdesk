# Copy this file to ".env" (same folder) and put YOUR OWN key below.
# Get a key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional. Model used for summaries (stable model listed in Google's docs).
GEMINI_MODEL=gemini-3.6-flash

# Optional. Port for this backend (the frontend proxy expects 3001).
PORT=3001
